    "still_dir": "host_stills",
    "talking_dir": "host_talking",
    "source_gif_dir": "host_talking_loop_gif",
    "host_fps": 12,
    "host_playback_rate": 1.0,
    "forbid_time_stretch_host": true,
    "note": "Prefer keyed talking_loop.gif at native 12fps (1x). Never speed GIFs to fit scene length. Light stage #EDEDED — host alpha, no black plate."
  },
  "chroma_key": {
    "enabled": false,
    "note": "Green removed offline. Transparent host on LIGHT stage. Do not chroma again; do not put host on a black rectangle."
  },

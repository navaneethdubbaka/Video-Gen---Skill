{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard.schema.json",
  "title": "DirectorStoryboard",
  "type": "object",
  "required": ["project", "language", "scenes"],
  "properties": {
    "project": { "type": "string" },
    "language": { "type": "string" },
    "message": { "type": "string" },
    "total_duration_s": { "type": "number" },
    "style_spec_path": { "type": "string" },
    "instructions": { "type": "string" },
    "packaging": {
      "type": "object",
      "description": "Click + series packaging for views/follows",
      "properties": {
        "title": { "type": "string" },
        "first_frame_note": { "type": "string" },
        "series_tag": { "type": "string" },
        "comment_bait": { "type": "string" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "start", "end", "narration", "concept", "visual", "pattern"],
        "properties": {
          "scene_id": { "type": "integer" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "narration": { "type": "string" },
          "concept": { "type": "string" },
          "pattern": {
            "type": "string",
            "description": "Style-pack scene pattern letter (A–K for insider-force-short). Required for visual diversity gates.",
            "pattern": "^[A-K]$"
          },
          "role": {
            "type": "string",
            "description": "Optional beat role for retention gates",
            "enum": ["hook", "body", "proof", "breath", "cta", "other"]
          },
          "visual": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "photograph",
                  "video_clip",
                  "screenshot",
                  "diagram",
                  "icon",
                  "text_only",
                  "generated_graphic",
                  "multiple"
                ]
              },
              "search_query": { "type": "string" },
              "asset_path": { "type": "string" },
              "entity": {
                "type": "string",
                "description": "Public figure or famous company/brand name to fetch via entity-images pipeline"
              },
              "requirement": {
                "type": "object",
                "properties": {
                  "subject": { "type": "string" },
                  "composition": {
                    "type": "object",
                    "properties": {
                      "subject_position": { "type": "string" },
                      "negative_space": { "type": "string" }
                    }
                  },
                  "purpose": { "type": "string" },
                  "minimum_resolution": { "type": "string" },
                  "narration_link": { "type": "string" },
                  "entity": { "type": "string" },
                  "entity_type": {
                    "type": "string",
                    "enum": ["person", "company", "organization", "brand", "product", "other"]
                  }
                }
              }
            }
          },
          "text": {
            "type": "object",
            "properties": {
              "content": { "type": "string" },
              "emphasis": { "type": "array", "items": { "type": "string" } }
            }
          },
          "motion": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "notes": { "type": "string" }
            }
          },
          "transition": { "type": "string" },
          "sfx": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "additionalProperties": true
}

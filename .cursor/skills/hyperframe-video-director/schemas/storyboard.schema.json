{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard.schema.json",
  "title": "DirectorStoryboard",
  "type": "object",
  "required": ["project", "language", "scenes"],
  "properties": {
    "project": { "type": "string" },
    "language": { "type": "string" },
    "message": { "type": "string" },
    "total_duration_s": { "type": "number" },
    "style_spec_path": { "type": "string" },
    "instructions": { "type": "string" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "start", "end", "narration", "concept", "visual"],
        "properties": {
          "scene_id": { "type": "integer" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "narration": { "type": "string" },
          "concept": { "type": "string" },
          "visual": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "photograph",
                  "video_clip",
                  "screenshot",
                  "diagram",
                  "icon",
                  "text_only",
                  "generated_graphic",
                  "multiple"
                ]
              },
              "search_query": { "type": "string" },
              "asset_path": { "type": "string" },
              "requirement": {
                "type": "object",
                "properties": {
                  "subject": { "type": "string" },
                  "composition": {
                    "type": "object",
                    "properties": {
                      "subject_position": { "type": "string" },
                      "negative_space": { "type": "string" }
                    }
                  },
                  "purpose": { "type": "string" },
                  "minimum_resolution": { "type": "string" },
                  "narration_link": { "type": "string" }
                }
              }
            }
          },
          "text": {
            "type": "object",
            "properties": {
              "content": { "type": "string" },
              "emphasis": { "type": "array", "items": { "type": "string" } }
            }
          },
          "motion": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "notes": { "type": "string" }
            }
          },
          "transition": { "type": "string" },
          "sfx": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "additionalProperties": true
}
